---
import type { Lang } from '../data/site';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="experience" class="section section--experience">
  <div class="container">
    <SectionHead
      index="05"
      kicker={t(lang, 'section.experience')}
      title={t(lang, 'section.experienceTitle')}
    />

    <ol class="timeline">
      {site.experience.map((item) => (
        <li class="timeline-row">
          <span class="timeline-period mono">{item.period[lang]}</span>
          <div class="timeline-main">
            <div class="timeline-role-line">
              <h3>{item.role[lang]}</h3>
              <span class="timeline-kind mono">{item.kind[lang]}</span>
            </div>
            <p>{item.summary[lang]}</p>
          </div>
          <span class="timeline-org">{item.organization[lang]}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
