---
import type { Lang } from '../data/site';
import { site } from '../data/site';
import { featuredPublications, publications } from '../data/publications';
import { publicationsPath } from '../i18n/utils';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const papers = publicationsPath(lang);
const allLabel = `${t(lang, 'publications.all')} (${publications.length})`;
---

<section id="publications" class="section section--publications">
  <div class="container">
    <SectionHead
      index="02"
      kicker={t(lang, 'section.publications')}
      title={t(lang, 'section.publicationsTitle')}
      lede={t(lang, 'publications.homeLede')}
      link={{ href: papers, label: allLabel }}
    />

    <ol class="publication-list">
      {featuredPublications.map((publication, index) => (
        <li class="publication-item">
          <span class="mono publication-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="publication-main">
            <h3>
              {publication.doi ? (
                <a
                  href={`https://doi.org/${publication.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {publication.title}
                </a>
              ) : (
                publication.title
              )}
            </h3>
            <p class="publication-authors">
              {publication.authors.map((author, authorIndex) => (
                <span class:list={['publication-author', { 'is-self': author === site.name }]}>
                  {author}{authorIndex < publication.authors.length - 1 ? ', ' : ''}
                </span>
              ))}
            </p>
            <p class="publication-venue">
              <span>{publication.venue}</span>
              <span aria-hidden="true">·</span>
              <span>{publication.year}</span>
              {publication.volume && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    Vol. {publication.volume}{publication.issue ? `(${publication.issue})` : ''}
                  </span>
                </>
              )}
              {publication.pages && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{publication.pages}</span>
                </>
              )}
            </p>
          </div>
          {publication.doi && (
            <a
              class="publication-link"
              href={`https://doi.org/${publication.doi}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t(lang, 'publications.read')}: ${publication.title}`}
            >
              <Icon name="arrow-up-right" size={18} />
            </a>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
