---
import type { Lang } from '../data/site';
import Contact from './Contact.astro';
import Experience from './Experience.astro';
import Funding from './Funding.astro';
import Hero from './Hero.astro';
import Insights from './Insights.astro';
import Projects from './Projects.astro';
import Publications from './Publications.astro';
import Research from './Research.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Hero lang={lang} />
<Research lang={lang} />
<Publications lang={lang} />
<Projects lang={lang} />
<Insights lang={lang} />
<Experience lang={lang} />
<Funding lang={lang} />
<Contact lang={lang} />
