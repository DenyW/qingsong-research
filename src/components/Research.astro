---
import type { Lang } from '../data/site';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="research" class="section section--research">
  <div class="container">
    <SectionHead
      index="01"
      kicker={t(lang, 'section.research')}
      title={t(lang, 'section.researchTitle')}
      lede={site.research.intro[lang]}
    />

    <div class="research-grid">
      {site.research.directions.map((direction) => (
        <article class="research-card">
          <div class="research-card-top">
            <span class="mono research-index">{direction.index}</span>
            <span class="research-arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={20} />
            </span>
          </div>
          <div class="research-card-body">
            <h3>{direction.title[lang]}</h3>
            <p>{direction.description[lang]}</p>
          </div>
          <ul class="tag-list" aria-label="Keywords">
            {direction.tags[lang].map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
