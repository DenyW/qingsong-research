---
import type { Lang } from '../data/site';
import { switchLangPath } from '../i18n/utils';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  pathname: string;
  class?: string;
}

const { lang, pathname, class: className } = Astro.props;
const target: Lang = lang === 'en' ? 'zh' : 'en';
const href = switchLangPath(pathname, lang);
---

<a
  class:list={['lang-toggle', className]}
  href={href}
  hreflang={target === 'zh' ? 'zh-Hans' : 'en'}
  lang={target === 'zh' ? 'zh-Hans' : 'en'}
  aria-label={t(lang, 'lang.switch')}
  title={t(lang, 'lang.switch')}
>
  <span class:list={['lang-option', { 'is-active': lang === 'en' }]}>EN</span>
  <span class="lang-divider" aria-hidden="true">/</span>
  <span class:list={['lang-option', { 'is-active': lang === 'zh' }]} lang="zh-Hans">中</span>
</a>
