---
import type { Lang } from '../data/site';
import { insightsByDate } from '../data/insights';
import { insightsPath } from '../i18n/utils';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import InsightCard from './InsightCard.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const notes = insightsPath(lang);
const latest = insightsByDate.slice(0, 3);
---

<section id="insights" class="section section--insights">
  <div class="container">
    <SectionHead
      index="04"
      kicker={t(lang, 'section.insights')}
      title={t(lang, 'section.insightsTitle')}
      link={{
        href: notes,
        label: t(lang, 'insights.all'),
      }}
    />

    {latest.length > 0 ? (
      <div class="insights-grid">
        {latest.map((post, index) => (
          <InsightCard post={post} lang={lang} featured={index === 0} />
        ))}
      </div>
    ) : (
      <p class="empty-state">{t(lang, 'insights.empty')}</p>
    )}

    <div class="insights-foot">
      <a class="text-link" href={notes}>
        {t(lang, 'insights.all')}
        <Icon name="arrow-right" size={14} />
      </a>
      <a class="text-link text-link--muted" href="/rss.xml">
        {t(lang, 'insights.rss')}
        <Icon name="rss" size={14} />
      </a>
    </div>
  </div>
</section>
