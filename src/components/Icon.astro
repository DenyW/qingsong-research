---
export type IconName =
  | 'arrow-up-right'
  | 'arrow-down'
  | 'arrow-right'
  | 'arrow-left'
  | 'github'
  | 'mail'
  | 'rss'
  | 'menu'
  | 'close'
  | 'globe'
  | 'external';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 16, strokeWidth = 1.7, class: className } = Astro.props;
const isFilled = name === 'github';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-up-right' && <><path d="M6 18 18 6" /><path d="M8 6h10v10" /></>}
  {name === 'arrow-down' && <><path d="M12 4v16" /><path d="m5 13 7 7 7-7" /></>}
  {name === 'arrow-right' && <><path d="M4 12h16" /><path d="m13 5 7 7-7 7" /></>}
  {name === 'arrow-left' && <><path d="M20 12H4" /><path d="m11 19-7-7 7-7" /></>}
  {name === 'github' && (
    <path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.56.1.77-.25.77-.55v-2.14c-3.14.68-3.8-1.33-3.8-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.72.39-1.22.71-1.5-2.51-.29-5.15-1.25-5.15-5.58 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.7 10.7 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.34-2.65 5.29-5.17 5.57.4.35.76 1.03.76 2.08v3.08c0 .3.2.66.78.55A11.3 11.3 0 0 0 12 .7Z" />
  )}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'rss' && <><path d="M5 19a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="currentColor" stroke="none" /><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /></>}
  {name === 'menu' && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></>}
  {name === 'close' && <><path d="m6 6 12 12" /><path d="M18 6 6 18" /></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18Z" /></>}
  {name === 'external' && <><path d="M14 4h6v6" /><path d="M20 4 10 14" /><path d="M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5" /></>}
</svg>
