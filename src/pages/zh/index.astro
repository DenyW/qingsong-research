---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeSections from '../../components/HomeSections.astro';
import { site } from '../../data/site';
import { t } from '../../i18n/ui';

const lang = 'zh' as const;
const base = Astro.site ?? new URL(site.url);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: base.toString(),
  jobTitle: site.role.zh,
  email: site.email,
  sameAs: site.socials
    .filter((social) => social.kind !== 'email')
    .map((social) => social.href),
  knowsAbout: [
    '三维机织物',
    '纺织复合材料',
    '弹道冲击',
    '有限元分析',
    '冲击损伤',
  ],
  knowsLanguage: ['en', 'zh-Hans'],
};
---

<BaseLayout
  lang={lang}
  title={undefined}
  description={t(lang, 'site.description')}
  jsonLd={personSchema}
>
  <HomeSections lang={lang} />
</BaseLayout>
