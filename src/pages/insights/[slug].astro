---
import InsightArticle from '../../components/InsightArticle.astro';
import { insightsByDate } from '../../data/insights';

export function getStaticPaths() {
  return insightsByDate.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      previous: insightsByDate[index + 1],
      next: insightsByDate[index - 1],
    },
  }));
}

const { post, previous, next } = Astro.props;
const lang = 'en' as const;
---

<InsightArticle post={post} lang={lang} previous={previous} next={next} />
