---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';

import type { Lang } from '../data/site';
import { site } from '../data/site';
import { t } from '../i18n/ui';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  lang = 'en',
  image = '/og.png',
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(image, base);
const pageTitle = title ? `${title} — ${site.name}` : t(lang, 'site.title');
const pageDescription = description ?? t(lang, 'site.description');
const rssHref = '/rss.xml';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t(lang, 'site.title'),
  url: base.toString(),
  inLanguage: 'en',
};

const structuredData = noindex
  ? undefined
  : jsonLd
    ? [websiteSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
    : websiteSchema;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1e8" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — RSS`} href={rssHref} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name} — Research`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline[lang]}`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y.skip')}</a>
    <Header lang={lang} pathname={Astro.url.pathname} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
